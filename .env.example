# Copy to .env and fill in the settings for the provider you use.
# Optional. Which provider this process uses: trello (default) or linear.
ISSUE_PROVIDER=trello

# Trello: credentials and the target list from your Trello test account.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Linear: a personal API key and the ID of the team new issues are created in.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Optional. Workflow state for new issues; Linear's default state when unset.
LINEAR_STATE_ID=

# Optional. File that records idempotency keys; must survive restarts and be shared by all workers.
IDEMPOTENCY_DB_PATH=idempotency.sqlite3
