# Copy to .env and fill in the settings for the provider you use.
# The service checks these at startup and refuses to start if a variable the
# selected provider requires is missing or empty. The error names the
# variable but never prints a value. The other provider's variables are
# never required.
#
# For the deployed service these are not read from a file: configuration is
# set in infra/main.tf and secrets in a Render environment group
# (docs/DEPLOYMENT.md).

# Optional. Which provider this process uses: trello (default) or linear.
ISSUE_PROVIDER=trello

# Trello (required when ISSUE_PROVIDER=trello): credentials and the target list
# from your Trello test account.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Linear (required when ISSUE_PROVIDER=linear): a personal API key and the ID
# of the team new issues are created in.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Optional. Workflow state for new issues; Linear's default state when unset.
LINEAR_STATE_ID=

# Optional. File that records idempotency keys; must survive restarts and be
# shared by all workers. With Trello, startup checks that its directory exists
# and is writable. Linear does not use it.
IDEMPOTENCY_DB_PATH=idempotency.sqlite3
